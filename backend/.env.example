# ==============================================================================
# TalkDeskly Backend Configuration Example (.env)
# Copy this file to '.env' and adjust the variables for your environment.
# ==============================================================================

# === Server Configuration ===
# The port the backend Go server listens on (default: 8080)
PORT=8080

# The public URL of your TalkDeskly instance (essential for CORS and WebSocket handshake)
# Local Docker Dev: http://localhost:8080
# Local Hybrid Dev: http://localhost:6721
# Production: https://chat.yourdomain.com
BASE_URL=http://localhost:8080

# The public URL of the Agent Console frontend dashboard
# Local Dev: http://localhost:3001
# Production: https://console.yourdomain.com
FRONTEND_URL=http://localhost:3001

# Environment mode: 'development' (verbose logging, mock services) or 'production'
# Env var name mapping in Go config: ENVIRONMENT (falls back to GO_ENV)
ENVIRONMENT=development
GO_ENV=development

# Log levels: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=debug

# === Security ===
# Secret key used for signing JWT tokens. Change this to a secure random string in production!
# You can generate a key using: openssl rand -hex 32
JWT_SECRET=f3b55c5e8de95821c97a5b399203a3d5e2e8b28cf9b3f4621cba1b9d4a8e2689

# === Databases ===
# PostgreSQL connection string (DATABASE_URL)
# Format: postgres://username:password@host:port/database_name?sslmode=disable
# Dev Docker: postgres://postgres:postgres@postgres:5432/talkdeskly
# Dev Hybrid: postgres://postgres:postgres@localhost:5433/talkdeskly
DATABASE_URL=postgres://postgres:postgres@localhost:5433/talkdeskly

# Redis connection string for caching and pub/sub messaging (REDIS_URL)
# Format: redis://[:password@]host:port[/db_number]
# Dev Docker: redis:6379
# Dev Hybrid: localhost:6379
REDIS_URL=localhost:6379

# === Outbound Email (SMTP) ===
# Email provider method: 'smtp' or 'mock' (logs emails to console instead of sending)
# Go Config default provider fallback: gomail (if set to smtp)
EMAIL_PROVIDER=smtp

# SMTP server address (Mailhog is used in local dev env)
# Dev Docker: mailhog
# Dev Hybrid: localhost
EMAIL_HOST=localhost

# SMTP server port (1025 for Mailhog, 587 for TLS, 465 for SSL)
EMAIL_PORT=1025

# SMTP credentials (leave empty if SMTP server doesn't require authentication like Mailhog)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Sender identity envelope address
EMAIL_FROM=noreply@talkdeskly.com

# === Localization ===
# Default locale language code
DEFAULT_LANGUAGE=en

# Supported language codes separated by commas
SUPPORTED_LANGUAGES=en,vi

# === Application settings ===
# Custom brand name for your TalkDeskly instance
APPLICATION_NAME=TalkDeskly

# Toggle to allow public registration of new agent users: 'true' or 'false'
ENABLE_REGISTRATION=false
