# ==============================================================================
# TalkDeskly Chat Bubble Client-side Configuration Template (.env.example)
# Copy this file to '.env' and adjust the variables for your local development.
# NOTE: All variables must be prefixed with VITE_ to be loaded into client code.
# ==============================================================================

# API Base URL pointing to the running backend server
# Local dev: http://localhost:8080/api (or http://localhost:8080/api for hybrid setup)
# Production: Not needed (automatically resolves from hosting server)
VITE_API_URL=http://localhost:8080/api

# WebSocket URL pointing to the running backend server
# Local dev: ws://localhost:8080/ws (or ws://localhost:8080/ws for hybrid setup)
# Production: Not needed (automatically resolves from hosting server)
VITE_WS_URL=ws://localhost:8080/ws
