# Host-run local backend environment.
# Copy to backend/.env when you need to recreate local startup config.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/talkdeskly
JWT_SECRET=secret
PORT=6721
BASE_URL=http://localhost:6721
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=info
REDIS_URL=localhost:6379
EMAIL_PROVIDER=smtp
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@talkdeskly.com
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en
APPLICATION_NAME=TalkDeskly
ENABLE_REGISTRATION=false
