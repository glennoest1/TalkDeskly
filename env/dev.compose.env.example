# Docker development environment reference.
# These values are documented for startup clarity.
# docker-compose.dev.yml currently sets them inline, so this file is not loaded automatically.

CHAT_BUBBLE_NODE_ENV=development
CHAT_BUBBLE_VITE_API_URL=http://localhost:8080/api
CHAT_BUBBLE_VITE_WS_URL=ws://localhost:8080/ws

BACKEND_GO_ENV=development
BACKEND_DATABASE_URL=postgres://postgres:postgres@postgres:5432/talkdeskly
BACKEND_PORT=8080
BACKEND_JWT_SECRET=secret
BACKEND_BASE_URL=http://localhost:8080
BACKEND_REDIS_URL=redis:6379
BACKEND_EMAIL_HOST=mailhog
BACKEND_EMAIL_PORT=1025
BACKEND_EMAIL_USERNAME=
BACKEND_EMAIL_PASSWORD=
BACKEND_EMAIL_FROM=noreply@talkdeskly.com

FRONTEND_NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talkdeskly

MAILHOG_MH_STORAGE=maildir
MAILHOG_MH_MAILDIR_PATH=/tmp
