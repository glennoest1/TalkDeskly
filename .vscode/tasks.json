{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Air",
      "type": "shell",
      "command": "air",
      "args": ["-c", ".air.toml"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$go",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*watching.*",
          "endsPattern": ".*running.*|.*started.*|.*listening.*"
        }
      }
    }
  ]
}
